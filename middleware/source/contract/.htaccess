RewriteEngine On

# 傳遞 Authorization Header 到 PHP (這段保留，JWT 驗證非常需要)
RewriteCond %{HTTP:Authorization} ^(.*)
RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]

# /contract/all → all.php
RewriteRule ^all$ all.php [L,QSA]

# /contract/{id}/transaction-token → 導向根目錄下的 /auth/contract_token.php?id={id}
RewriteRule ^([0-9]+)/transaction-token$ /auth/contract_token.php?id=$1 [L,QSA]

# /contract/{id} → index.php?id={id}
RewriteRule ^([0-9]+)$ index.php?id=$1 [L,QSA]